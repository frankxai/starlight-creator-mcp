{
  "name": "starlight-creator-mcp-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --if-present run build",
    "typecheck": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "e2e": "pnpm --filter @starlight-intelligence/creator-server run e2e",
    "lint": "eslint .",
    "test:release": "node --test scripts/test/*.test.mjs",
    "release:preflight": "node scripts/check-release-readiness.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:consumer": "node scripts/test-consumer.mjs",
    "inspect": "npx --yes @modelcontextprotocol/inspector node packages/server/dist/stdio.js",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
